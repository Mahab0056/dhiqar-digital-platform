# ---- Runtime ---------------------------------------------------------------------------------
NODE_ENV=development
PORT=8787
# Public HTTPS origin of the deployment (used for CORS, OTP webhooks, links)
PUBLIC_BASE_URL=https://dhiqar-digital-platform-production.up.railway.app
# Extra allowed browser origins (comma separated), e.g. custom domains
ALLOWED_ORIGINS=https://thi-qar.com,https://www.thi-qar.com

# ---- Secrets (REQUIRED in production; generate with: openssl rand -base64 48) -----------------
SESSION_SECRET=change-me-long-random-string
MEDIA_ENCRYPTION_KEY=change-me-long-random-string
OTP_HASH_SECRET=change-me-long-random-string
# Optional: separate key for MFA secrets at rest (falls back to SESSION_SECRET)
# MFA_ENCRYPTION_KEY=

# ---- First super-admin account (used only when the staff table is empty) ---------------------
STAFF_BOOTSTRAP_USERNAME=admin
STAFF_BOOTSTRAP_PASSWORD=Change-This-Bootstrap-Password-2026!
STAFF_BOOTSTRAP_FULL_NAME=مدير النظام
# Legacy shared passwords (pre-accounts deployments). If set on first boot they become
# named accounts (superadmin / employee / operations) that must rotate their password on login.
# SUPER_ADMIN_PASSWORD=
# ADMIN_REVIEW_PASSWORD=
# OPERATIONS_PASSWORD=

# ---- Database (SQLite) ------------------------------------------------------------------------
# Default: ./data/dhiqar-demo.sqlite, or $RAILWAY_VOLUME_MOUNT_PATH/dhiqar-demo.sqlite on Railway
# DATABASE_PATH=/data/dhiqar.sqlite
# Backups: VACUUM INTO snapshots next to the database (BACKUP_DIR), pruned by age
# BACKUP_DIR=/data/backups
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_KEEP=7
# BACKUP_ENABLED=false

# ---- Media & identity -------------------------------------------------------------------------
# MEDIA_STORAGE_PATH=/data/media
# IDENTITY_DOCUMENT_AI_ENDPOINT=
# IDENTITY_DOCUMENT_AI_KEY=
# IDENTITY_OCR_CACHE_PATH=

# ---- OTP (OTPIQ) -------------------------------------------------------------------------------
# OTPIQ_API_KEY=
# OTPIQ_WEBHOOK_SECRET=
# Local development only (ignored in production): accept a fixed code without sending SMS
OTP_DEV_MODE=true
OTP_DEV_CODE=246810
